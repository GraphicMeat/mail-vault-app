<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Embedded into the Mach-O as __TEXT,__info_plist by build.rs. Without
         it libsystem_secinit has no bundle identity to build a container from
         and aborts the process at launch (SIGTRAP, launchd reports exit -5),
         which is exactly what a sandboxed standalone binary does. Microsoft
         Teams' bundled agents carry the same two keys and nothing else. -->
    <key>CFBundleIdentifier</key>
    <string>com.mailvault.app.probe</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
</dict>
</plist>
