# Server
PORT=3001

# CORS - set to your website domain in production
CORS_ORIGIN=https://mailvaultapp.com

# Security
IP_SALT=change-this-to-a-random-string
ADMIN_KEY=change-this-to-a-secure-admin-key

# Mail goes through graphicmeat.com, which holds the only Purelymail
# credentials and owns the shared subscribers table. This site sends nothing
# itself, so there are deliberately NO SMTP_* or NOTIFY_EMAIL variables here —
# contact notifications land at GraphicMeat's CONTACT_TO, sign-up notices at
# its NEWSLETTER_NOTIFY.
#
# The key must match PARTNER_API_KEY in graphicmeat.com's secrets.env.
GRAPHICMEAT_PARTNER_URL=https://graphicmeat.com
GRAPHICMEAT_PARTNER_KEY=change-me-to-match-graphicmeat-PARTNER_API_KEY

# Database (optional - defaults to ./data.json)
# DB_PATH=/path/to/data.json

# Stripe Billing (required for premium features)
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# EUR-based prices with currency_options for USD/GBP + Stripe Adaptive Pricing
STRIPE_PRICE_MONTHLY_EUR=price_...
STRIPE_PRICE_YEARLY_EUR=price_...
# Legacy USD-only fallback (used if _EUR vars not set)
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# Early Bird & Family Pricing is the two prices above, capped at 100 live
# subscriptions (active, trialing or past_due), counted by GET /api/billing/early-bird.
# Once all 100 are taken, checkout sells these standard prices instead; while they
# are unset it refuses with "Early Bird spots are taken; standard pricing opens soon."
# Same naming as above: the _EUR variant wins when both are set.
# STRIPE_PRICE_MONTHLY_STANDARD_EUR=price_...
# STRIPE_PRICE_YEARLY_STANDARD_EUR=price_...
# STRIPE_PRICE_MONTHLY_STANDARD=price_...
# STRIPE_PRICE_YEARLY_STANDARD=price_...
# Stripe customer ids (comma-separated) whose subscriptions never take an Early Bird
# spot, such as the owner's own test subscriptions.
# EARLY_BIRD_EXCLUDE_CUSTOMERS=cus_...,cus_...
# Webhook secret from: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Free-trial length in days, applied to BOTH monthly and yearly checkouts.
# Falls back to YEARLY_TRIAL_DAYS, then 14, if unset.
# TRIAL_DAYS=14

# Aggregate metrics summary token. If unset, GET /api/metrics/summary returns 404.
# METRICS_TOKEN=change-this-to-a-secure-random-string

# Billing redirect URLs (defaults to mailvaultapp.com)
# BILLING_SUCCESS_URL=http://localhost:5173/billing-success.html
# BILLING_CANCEL_URL=http://localhost:5173/billing-cancel.html

# Self-hosted analytics (meatlytics) — see /_analytics on this site once running.
# Dashboard login is passkey-based (first boot logs a one-time setup link).
# API key used for hub pulls (a peer site's dashboard fetching this site's stats):
ANALYTICS_API_KEY=change-me-to-a-long-random-string
# Optional: makes this dashboard a hub that also shows the graphicmeat site.
# Only set both if that site's meatlytics is reachable from here.
# GRAPHICMEAT_ANALYTICS_URL=https://graphicmeat.com
# GRAPHICMEAT_ANALYTICS_KEY=the-api-key-graphicmeat-issued-for-this-peer
