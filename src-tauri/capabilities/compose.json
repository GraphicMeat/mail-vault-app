{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "compose-window",
  "description": "Minimal capability for trusted compose editor windows",
  "windows": ["compose-*"] ,
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-destroy", "core:window:allow-set-focus", "core:window:allow-set-size", "dialog:allow-open", "fs:allow-read-text-file", "drag:default", "shell:allow-open"]
}
